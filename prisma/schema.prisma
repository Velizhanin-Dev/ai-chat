generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Document {
  id        String   @id @default(cuid())
  source    String
  speaker   String?
  createdAt DateTime @default(now())
  chunks    Chunk[]
}

model Chunk {
  id         String   @id @default(cuid())
  text       String
  pineconeId String
  document   Document @relation(fields: [documentId], references: [id])
  documentId String
  createdAt  DateTime @default(now())
}

// Легаси: сообщения по sessionId без привязки к юзеру — больше не используется
// (история чатов теперь в Conversation/Message ниже). Таблицу не трогаем.
model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  sessionId String
  createdAt DateTime @default(now())
}

// ── История чатов (кросс-девайсная) ────────────────────────────────────────
// Источник правды по диалогам пользователя. id диалога генерит клиент (nanoid)
// и шлёт в /api/chat — там диалог создаётся и пополняется сообщениями. Сообщения
// тянутся лениво (GET /api/conversations/[id]); список — метаданными.
model Conversation {
  id        String    @id // клиентский nanoid (см. chatSlice.makeConversation)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("Новый чат")
  // Бриф проекта (1 проект = 1 диалог). Структура — тип Brief (src/lib/brief.ts).
  // Заполняется при создании проекта; источник правды для system-промпта в чате
  // (раньше бриф был привязан к User — теперь к конкретному проекту/диалогу).
  brief     Json?
  // Площадка проекта: "youtube" | "instagram" (см. Platform в src/lib/platform.ts).
  // ⚠️ Проект привязан к ОДНОЙ площадке: от неё зависят разделы меню, состав
  // аналитики и формат превью (16:9 против 9:16). Сменить площадку у готового
  // проекта нельзя — цифры и превью прошлой площадки к новой не относятся.
  platform  String    @default("youtube")
  messages  Message[]
  // Пер-проектная интеграция YouTube (см. модель YouTubeIntegration ниже).
  youtube   YouTubeIntegration?
  // Пер-проектная интеграция Instagram (см. InstagramIntegration ниже).
  instagram InstagramIntegration?
  // Референсы и сгенерированные превью проекта (см. модель Thumbnail ниже).
  thumbnails Thumbnail[]
  jobs       Job[]
  // История разборов канала по параметрам продвижения (см. ChannelAnalysis ниже).
  analyses  ChannelAnalysis[]
  // Дорожная карта канала (движок шагов, см. ChannelRoadmap ниже).
  roadmap   ChannelRoadmap?
  // Каналы-конкуренты, добавленные руками (см. TrackedChannel ниже).
  trackedChannels TrackedChannel[]
  searches        CompetitorSearch[]
  // Слать ли в Telegram уведомления «у конкурента залетел ролик» (см. CompetitorAlert).
  // Выключено по умолчанию: уведомления — это то, на что подписываются осознанно.
  competitorAlerts Boolean @default(false)
  alerts          CompetitorAlert[]
  // Контент-планы по месяцам (см. ContentPlan ниже).
  contentPlans ContentPlan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
}

// Генератор превью: и загруженные референсы, и результаты генерации лежат одной
// таблицей (различаются `kind`) — так генерация ссылается на свои референсы
// (`refIds`) и вся история проекта читается одним запросом.
// САМИ ФАЙЛЫ в БД не хранятся: пишутся на диск в UPLOAD_DIR (volume, см.
// src/lib/uploads.ts), здесь только относительный путь + метаданные.
model Thumbnail {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Автор (для телеметрии/аудита). SetNull — историю проекта не теряем.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind           String // "reference" | "generation"
  // Для kind="reference": роль в кадре — "speaker" | "object" | "style"
  // (спикера переносим по личности, объект по форме, стиль — по композиции).
  role           String       @default("speaker")
  // Путь ОТНОСИТЕЛЬНО UPLOAD_DIR, напр. "thumbnails/<convId>/<cuid>.jpg".
  filePath       String
  mimeType       String
  bytes          Int          @default(0)
  // Подпись референса («спикер» / «объект») или заголовок генерации.
  label          String       @default("")
  // Для kind="generation": id референсов, ушедших в запрос (порядок = Image 1..N).
  refIds         String[]     @default([])
  // Вариации одного превью: перегенерация из редактора ссылается на исходную
  // картинку. null = самостоятельное превью (корень группы). В галерее группа
  // показывается одной карточкой — последней версией.
  parentId       String?
  // Для kind="reference": «применять всегда». Так стиль-референс держит единый
  // вид превью для всех роликов канала, не выбирая его заново каждый раз.
  pinned         Boolean      @default(false)
  // Спека арт-директора (ThumbnailSpec, src/lib/thumbnails.ts) — из чего собран промпт.
  spec           Json?
  // Финальный английский промпт, ушедший в image-модель (для отладки/повтора).
  prompt         String?
  model          String       @default("")
  costUsd        Float        @default(0)
  createdAt      DateTime     @default(now())

  @@index([conversationId, kind, createdAt])
  @@index([conversationId, parentId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Разбор канала по параметрам органического продвижения (раздел «Канал» → кнопка
// «Разобрать канал»). Храним ВСЮ историю разборов: по ней видно прогресс канала
// «было/стало» и не тратится квота на повторный просмотр уже сделанного.
// Ключ выборки — (проект, срез): kind + periodDays.
model ChannelAnalysis {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Автор разбора (для телеметрии). SetNull — историю проекта не теряем.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Что разбирали: "all" | "long" | "shorts". У шортсов свой набор параметров
  // (6 параметров конверсии), у лонгов — 7 параметров продвижения.
  kind           String       @default("all")
  // Окно аналитики в днях; 0 = за всё время жизни канала.
  periodDays     Int          @default(28)
  // Снимок собранных цифр (ChannelDiagnostics) — чтобы старый разбор в истории
  // читался сам по себе, без повторного похода в YouTube.
  metrics        Json
  // Результат модели (ChannelAnalysisResult): параметры со score 0-100 + вывод.
  result         Json
  // Общий балл 0-100 (среднее по параметрам) — для сравнения разборов в истории.
  overallScore   Int          @default(0)
  // CTR, введённый руками из YouTube Studio (API его не отдаёт). null — не вводили.
  manualCtr      Float?
  model          String       @default("")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ── Дорожная карта канала (движок шагов) ───────────────────────────────────
// docs/channel-roadmap.md + src/lib/roadmap.ts. Пер-проектная (1 проект = 1
// диалог = 1 канал). Один снапшот сигналов канала + список шагов JSON-ом:
// шаги отбираются по цифрам (SEO/CTR/подписка/вовлечение/удержание), открываются
// по одному раз в 2 дня, а выполнение проверяется диффом снапшотов (не по клику).
// Закрытый шаг зажигает соответствующую ачивку-шаг (completeStep).
model ChannelRoadmap {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Последний собранный снимок сигналов (RoadmapSignals) + когда собран.
  signals        Json?
  signalsAt      DateTime?
  // Состояние шагов: RoadmapStepState[] (key, order, claimedAt, doneAt, baseline).
  steps          Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ── Контент-план (месячная сетка роликов) ──────────────────────────────────
// docs/content-plan.md. Пер-проектный, по месяцам (прошлые хранятся, current —
// свежий). Генерируется по методике (CONTENT_PLAN_GUIDE, 8–12 роликов/мес, 25
// запросов квоты). Опорные блоки (портреты ЦА / лестница Ханта / воронка) —
// JSON, генерятся по желанию. Ролики — ContentPlanVideo (канбан по статусам).
model ContentPlan {
  id             String             @id @default(cuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Ключ месяца "2026-07" (для сортировки/архива) + человеческая метка "Июль 2026".
  period         String
  label          String
  // Снимок ниши/брифа на момент генерации (чтобы план читался сам по себе).
  niche          String?
  // Опорные блоки (Фаза 3, генерятся по желанию): портреты ЦА, легенда Ханта, воронка.
  audience       Json?
  huntLadder     Json?
  funnel         Json?
  model          String             @default("")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  videos         ContentPlanVideo[]

  @@index([conversationId, period])
}

// Один ролик в контент-плане. Поля — из методики (см. CONTENT_PLAN_GUIDE).
// Массивы (titles/previewTexts/questions) — варианты/скелет. status — канбан.
model ContentPlanVideo {
  id           String      @id @default(cuid())
  planId       String
  plan         ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  order        Int         @default(0)
  // "video" (лонг) | "short" (шортс — облегчённые поля).
  kind         String      @default("video")
  // Канбан: "idea" | "in_progress" | "published" | "cancelled".
  status       String      @default("idea")
  // Источник строки: "ai" (сгенерирована) | "manual" (добавил юзер) | "imported"
  // (импортирован реальный ролик канала).
  source       String      @default("ai")
  // Поля методики. titles/previewTexts — 1–3 варианта (A/B), questions — 10 (скелет).
  titles       String[]
  previewTexts String[]
  format       String?     // охватное | экспертное | продающее
  noSpeaker    Boolean     @default(false) // подтип «охватное без спикера»
  huntStage    String?     // стадия лестницы Ханта (словами)
  pain         String?     // боль ЦА от первого лица
  questions    String[]    // 10 вопросов/тезисов — скелет ролика
  nativeClose  String?     // нативное закрытие (на что мягко закрываем)
  cta          Json?       // { like, subscribe, comment, link, leadMagnet } — строки
  visp         Json?       // { v,i,s,p } — булевы галочки ВИСП
  reference    String?     // референс (видео-донор): текст или ссылка
  whyWorks     String?     // «почему тема залетит» (универсальный страх/желание)
  opening      String?     // прописанный опенинг (первый крючок)
  // Связь с реальным роликом YouTube (Фаза 2). Привязан → снимок превью/просмотров.
  youtubeVideoId String?
  thumbnail      String?
  views          Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([planId, order])
}

// ── Auth ──────────────────────────────────────────────────────────────────
// Реальная регистрация/вход на бэкенде: пароль хранится хэшем (bcrypt),
// сессия — подписанный JWT в httpOnly-cookie (см. src/lib/auth.ts).

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String
  // null у OAuth-юзеров (вход через VK/Яндекс, своего пароля нет).
  passwordHash  String?
  // План тарифа: "start" | "blogger" | "studio" (см. PlanId в authSlice).
  plan          String              @default("start")
  // Роль: "user" | "admin". Доступ в /admin и /api/admin/* проверяется по ней
  // на сервере (getAdminUser в src/lib/admin.ts). По умолчанию обычный юзер.
  role          String              @default("user")
  // Когда подтверждён email. null = не подтверждён (вход пока не блокируем).
  emailVerified DateTime?
  // Бриф клиента + результат DISC-теста (карта харизмы). Структура — тип Brief
  // в src/lib/brief.ts; подгружается в модель (см. route.ts). null = не проходил.
  brief            Json?
  // Когда бриф пройден. null = не проходил → обязательный гейт перед чатом.
  briefCompletedAt DateTime?
  // Платный тариф активен до этого момента (продление = новый платёж). null —
  // нет платной подписки (триал/бессрочно). rebillId — токен ТБанк для будущих
  // автосписаний (регистрируем при первом платеже, Recurrent=Y).
  planExpiresAt DateTime?
  rebillId      String?
  // Сколько запросов к ассистенту израсходовано в ТЕКУЩЕМ периоде тарифа. Один
  // ответ нейронки (kind=chat, без классификации) = 1 единица. Лимит на период —
  // Plan.limits.requests (-1 = без лимита), редактируется в админке. Сбрасывается
  // в 0 при выдаче/смене тарифа (регистрация-триал, оплата, правка из админки).
  // Когда юзеру в последний раз выдавался пробный период. Сравнивается с
  // AppSettings.trialResetAt: если метка сброса НОВЕЕ этой даты — при первом же
  // заходе человек получает пробный период заново (см. maybeGrantTrial).
  // ⚠️ Нужна именно отметка, а не вывод из planExpiresAt: у легаси-юзеров срок
  // null, и без маркера им бы обнуляли квоту на каждом запросе.
  // Чат в Telegram, связанный с аккаунтом (кнопка «Поддержка в Telegram»).
  // Ставится ботом при /start с одноразовым токеном; по нему ответы админа
  // уходят человеку в личку. null — не связывал.
  telegramChatId String?   @unique
  // Активные сессии-устройства (лимит — из тарифа, см. модель Device).
  devices        Device[]
  trialGrantedAt DateTime?
  requestsUsed  Int                 @default(0)
  // Последний визит — обновляется при входе и (с троттлингом) на любом
  // авторизованном запросе через getSessionUser. null = ни разу после введения поля.
  lastSeenAt    DateTime?
  // Первое касание: по какой ссылке человек попал к нам ВПЕРВЫЕ (см. src/lib/utm.ts).
  // Пишется один раз при регистрации и больше не меняется — это «откуда он пришёл».
  // Метку на момент покупки хранит Payment (там она может быть другой).
  // referrer/landing заполняются и без utm — по ним видно органику и прямые заходы.
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  utmReferrer   String?
  utmLanding    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tokens        VerificationToken[]
  oauthAccounts OAuthAccount[]
  payments      Payment[]
  conversations Conversation[]
  stats         Stat[]
  thumbnails    Thumbnail[]
  jobs          Job[]
  analyses      ChannelAnalysis[]
  // Черновое подключение YouTube на время прохождения брифа (см. модель ниже).
  youtubePending YouTubePendingConnection?
  // Переписка с техподдержкой (см. модель SupportMessage ниже).
  supportMessages SupportMessage[]
  // Геймификация: счётчики действий, дни активности и взятые ачивки (docs/achievements.md).
  counters        UserCounter[]
  activityDays    UserActivityDay[]
  achievements    UserAchievement[]
}

// ── Геймификация (ачивки) ──────────────────────────────────────────────────
// Подробности и правила — docs/achievements.md. Три таблицы: счётчики действий,
// дни активности (из них считаются серия и «всего активных дней») и взятые
// уровни ачивок. Прогресс в UserAchievement НЕ хранится — он всегда считается
// из счётчиков, чтобы не разъезжался при правке каталога.

// Счётчик действий пользователя. key — CounterKey из src/lib/achievements.ts
// ("chat_message", "thumbnail_generated", …). Инкремент атомарный (upsert +
// increment), значение только растёт: удалил проект — взятую ачивку не отбираем.
model UserCounter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// День, в который у юзера было хоть одно засчитанное действие (дата по UTC).
// Отдельная таблица, а не счётчик: серия — это непрерывность, из числа нельзя
// восстановить, был ли разрыв.
model UserActivityDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
}

// Взятая ачивка. level — сколько уровней (tiers) закрыто; не понижается при
// правке каталога. seenAt — когда пользователь увидел последний взятый уровень
// (null = показываем метку «новое»).
model UserAchievement {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  level      Int       @default(0)
  unlockedAt DateTime  @default(now())
  seenAt     DateTime?

  @@unique([userId, code])
}

// Интеграция с Instagram (Instagram API with Instagram Login).
//
// ПЕР-ПРОЕКТНАЯ, как и YouTube: 1 проект = 1 аккаунт. Нужен профессиональный
// аккаунт (Business/Creator) — у личного insights не отдаются вовсе.
//
// ⚠️ Токен живёт 60 дней и продлевается сам (ig_refresh_token); refresh-токена,
// как у Google, здесь НЕТ — просрочили, и человек подключает аккаунт заново.
// Поэтому tokenExpiresAt важен: по нему UI заранее просит переподключиться.
// ⚠️ Токен хранится как есть — TODO зашифровать в проде (как rebillId).
model InstagramIntegration {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  igUserId       String
  username       String
  name           String
  profilePicture String?
  followers      Int          @default(0)
  accessToken    String
  tokenExpiresAt DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Расшифровка ролика (субтитры), добытая через yt-dlp.
//
// Кэш в БД, а не в памяти: субтитры у вышедшего ролика не меняются, а добыча —
// это внешний процесс на десятки секунд. Данные ПУБЛИЧНЫЕ и от проекта не зависят,
// поэтому таблица общая на всех, ключ — videoId.
//
// ⚠️ Пустой text — это ЗАПОМНЕННОЕ «субтитров нет»: без такой записи мы гоняли бы
// yt-dlp на каждый разбор ролика, у которого их и не было.
model VideoTranscript {
  id        String   @id @default(cuid())
  videoId   String   @unique
  /** Код дорожки: "ru", "ru-en" (автоперевод), "en"… Пусто — субтитров нет. */
  language  String
  auto      Boolean  @default(false)
  text      String
  /** Реплики с таймингами: [{ at: секунда, text }]. */
  segments  Json
  createdAt DateTime @default(now())
}

// ── Устройства (активные сессии) ───────────────────────────────────────────
// Сколько устройств можно держать на аккаунте — из тарифа (Plan.limits.devices,
// 0/-1 = без лимита). Проверка при ВХОДЕ: сессия не выдаётся, пока не освободят
// слот (удалить лишнее устройство может любой, кто уже вошёл, — в настройках).
// Связь с сессией — claim `did` в JWT: удалили строку → токен перестал работать
// (getSessionUser отдаёт гостя). Старые токены без `did` считаются легаси и
// продолжают работать до истечения.
model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Снимок браузера/системы на момент входа — по нему человек узнаёт устройство.
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, lastSeenAt])
}

// ── Конкуренты: каналы, добавленные РУКАМИ ─────────────────────────────────
// Раздел «Референсы» → вкладка «Каналы в нише» сам собирает каналы из выдачи
// роликов, но эта выборка живёт 6 часов в памяти и меняется от запроса к запросу.
// Свой список конкурентов — то, за чем следят постоянно, поэтому он в БД и
// привязан к ПРОЕКТУ (у каждого проекта своя ниша).
// Снимок title/thumbnail/subscribers — чтобы рисовать карточку без похода в API;
// освежается при пересборке вкладки.
model TrackedChannel {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId      String
  title          String
  thumbnail      String?
  customUrl      String?
  subscribers    Int          @default(0)
  note           String?
  createdAt      DateTime     @default(now())
  stats          TrackedChannelStat[]

  @@unique([conversationId, channelId])
}

// Дневной снимок цифр отслеживаемого канала. Публичные данные (подписчики,
// просмотры, число роликов) YouTube отдаёт только НА СЕЙЧАС — истории у него нет,
// поэтому «кто в нише растёт, а кто стоит» можно показать, только если копить
// снимки самим. Пишем не чаще раза в сутки на канал (день по UTC).
model TrackedChannelStat {
  id          String         @id @default(cuid())
  channelRowId String
  channel     TrackedChannel @relation(fields: [channelRowId], references: [id], onDelete: Cascade)
  day         DateTime       @db.Date
  subscribers Int
  views       BigInt
  videoCount  Int

  @@unique([channelRowId, day])
}

// Сохранённая выдача поиска референсов.
//
// ⚠️ Раньше запуск жил ТОЛЬКО в памяти процесса, и это стоило денег: перезапуск
// или деплой — и тот же самый поиск шёл в YouTube заново по 100 units за запрос,
// хотя человек ничего не менял. Теперь выдача лежит в БД: повтор в пределах TTL
// бесплатен, «Добрать ещё» переживает рестарт (в tokens — где остановились по
// каждому запросу, в seen — уже разобранные id, за их метаданные второй раз не платим).
model CompetitorSearch {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /** Ключ запуска: запросы + период + порядок (см. resultKey). */
  key            String
  result         Json
  tokens         Json
  seen           String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, key])
}

// Уже отправленное уведомление «у конкурента залетел ролик». Нужна ровно для
// дедупликации: сканер ходит по расписанию и один и тот же ролик видит много раз.
model CompetitorAlert {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  videoId        String
  ratio          Float
  createdAt      DateTime     @default(now())

  @@unique([conversationId, videoId])
}

// ── Чат техподдержки ───────────────────────────────────────────────────────
// Один сквозной тред на пользователя (как в интеркоме), отдельных тикетов нет:
// человек пишет из сайдбара («Нужна помощь?»), админ отвечает в /admin/support.
// role: "user" (написал клиент) | "admin" (ответила поддержка).
// readAt — когда сообщение увидела ПРОТИВОПОЛОЖНАЯ сторона: по нему считаем
// непрочитанные (юзеру — ответы админа, админу — вопросы юзеров).
// Каждое сообщение юзера дублируется уведомлением в Telegram (src/lib/telegram.ts).
model SupportMessage {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([role, readAt])
}

// Интеграция с YouTube (Google OAuth + YouTube Data API v3 / Analytics API).
// ПЕР-ПРОЕКТНАЯ (1 проект = 1 диалог = 1 канал): у каждого проекта свой канал,
// возможно на разных Google-аккаунтах или разные каналы одного аккаунта. Поэтому
// привязка к Conversation (@unique conversationId), а не к User. Подключается в
// настройках ПРОЕКТА («Интеграции»), ОТДЕЛЬНО от OAuth-входа (VK/Яндекс): юзер уже
// залогинен, а мы получаем и храним токены доступа к каналу, чтобы дёргать API от
// его имени. accessToken живёт ~1ч, обновляем по refreshToken (getValidAccessToken).
// Снимок канала (title/thumbnail/customUrl) кэшируем для карточки «подключено» без
// запроса к Google; живые данные тянет /api/integrations/youtube/data?projectId=.
// ⚠️ Токены пока хранятся как есть — TODO зашифровать в проде (как rebillId).
model YouTubeIntegration {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId      String
  title          String
  thumbnail      String?
  customUrl      String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime
  scope          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Черновое подключение YouTube ДО создания проекта. На брифе нового проекта канал
// предлагается подключить ПЕРВЫМ шагом — но проекта тогда ещё нет (он создаётся в
// самом конце брифа), а YouTubeIntegration требует conversationId. Поэтому токены
// временно висят на юзере (1 черновик на юзера, @unique userId), а при создании
// проекта переезжают в YouTubeIntegration и черновик удаляется (attachPendingConnection
// в src/lib/youtube.ts). Живут недолго — до конца брифа; висячие чистит тот же
// upsert при следующем подключении. ⚠️ Токены как есть — TODO шифровать (как rebillId).
model YouTubePendingConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId      String
  title          String
  thumbnail      String?
  customUrl      String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime
  scope          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Телеметрия каждого вызова модели (снимаем то, что раньше уходило только в логи).
// Источник для CRM-дашборда админки: деньги, запросы, чаты, токены, топ юзеров.
// kind: "chat" (ответ ассистента) | "title" (заголовок диалога) | "router"
// (классификатор знаний). userId — SetNull при удалении юзера (финансовую историю
// не теряем, просто обезличивается). Стоимость — в USD (тарифы провайдеров $).
model Stat {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  kind             String
  provider         String // "claude" | "glm"
  model            String
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId   String?
  routeCategory    String? // chat|short|long|method (для kind=chat/router)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cachedTokens     Int      @default(0) // чтение из кэша
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  latencyMs        Int?

  @@index([createdAt])
  @@index([userId])
  @@index([kind, createdAt])
}

// Платежи (эквайринг ТБанк). Источник правды по факту оплаты — вебхук-уведомление
// (+ синхронизация через GetState на возврате). id используется как OrderId в ТБанк.
// Статусы ТБанк: NEW | FORM_SHOWED | AUTHORIZED | CONFIRMED | REJECTED | REFUNDED …
model Payment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  amount         Int // в копейках
  status         String    @default("NEW")
  // Провайдер оплаты: "tbank" (рос. карты/СБП/Мир) или "cloudpayments" (зарубежные
  // карты Visa/Mastercard). От него зависит синхронизация статуса на возврате.
  provider       String    @default("tbank")
  tbankPaymentId String? // внешний id транзакции (ТБанк PaymentId / CloudPayments TransactionId)
  rebillId       String?
  // Метка на момент оформления платежа (last-touch, см. src/lib/utm-client.ts).
  // Отдельно от меток юзера: человек мог прийти впервые из телеграма, а купить —
  // после рассылки. Пусто, если меток не было вовсе (тогда в отчёте берём метку юзера).
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  paidAt         DateTime?

  @@index([userId])
}

// Привязка соц-аккаунта (VK / Яндекс) к пользователю. Матчим вход по паре
// (provider, providerAccountId) — устойчиво к смене email; email опционален
// (VK может его не отдать). См. src/lib/oauth.ts.
model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String   // "yandex" | "vk"
  providerAccountId String   // id пользователя у провайдера
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Глобальные настройки приложения / фичефлаги. key→JSON, чтобы добавлять новые
// флаги без миграций. Читается через src/lib/settings.ts (с дефолтами), правится
// из админки (PATCH /api/admin/settings). Ключи: "brief_page_enabled", "launch".
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Тарифы — редактируемые из админки (цена, период, фичи-буллеты, числовые лимиты).
// id совпадает с историческим PlanId (start|blogger|studio), на него ссылается
// User.plan. Лендинг (Pricing) и биллинг в настройках читают отсюда; PLAN_LABEL в
// authSlice остаётся лишь дефолтом-фолбэком. См. src/lib/plans.ts.
//   limits (Json): { requests, contentPlans, scenarios, shorts } — число, где
//   -1 = без лимита, 0/нет = не применимо. Источник правды для будущих квот.
model Plan {
  id          String   @id
  label       String
  priceRub    Int
  period      String
  features    String[]
  limits      Json
  order       Int      @default(0)
  highlighted Boolean  @default(false)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Одноразовые токены: подтверждение почты и сброс пароля. В БД лежит ХЭШ
// токена (sha256), в письмо уходит сырой токен. type: "email_verify" |
// "password_reset".
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// Фоновая задача (очередь на Postgres, без брокера). Зачем: генерация превью,
// контент-плана и разборы идут десятки секунд, а раньше жили внутри HTTP-запроса —
// пользователь обновил страницу или ушёл, и результат терялся вместе с потраченной
// квотой. Теперь запрос ставит задачу и сразу отдаёт id; воркер выполняет её вне
// запроса, результат ложится сюда, клиент забирает его в любой момент и с любого
// устройства.
//
// Очередь на БД, а НЕ на брокере (RabbitMQ и т.п.): результат всё равно надо
// хранить, у нас один инстанс приложения, а `FOR UPDATE SKIP LOCKED` держит
// тысячи задач в минуту — на порядки выше нашей нагрузки. Если инстансов станет
// несколько и упрёмся — меняется только claimJob(), API и клиент не трогаются.
//
// kind — что делать (см. JOB_KINDS в src/lib/jobs.ts), payload — вход обработчика,
// result — то, что раньше уходило в JSON-ответ роута.
model Job {
  id     String @id @default(cuid())
  kind   String
  // queued | running | done | error | canceled
  status String @default("queued")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Проект, к которому относится задача (у аккаунтных задач — null). По нему
  // страница проекта находит «свои» незавершённые задачи после перезагрузки.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  payload Json
  result  Json?
  error   String?

  // Сколько раз брали в работу. Задача, у которой воркер умер посреди работы,
  // переедет обратно в queued по таймауту lockedAt — но не бесконечно.
  attempts Int     @default(0)
  // Кто и когда взял задачу. Пара нужна для «переехавших» задач: воркер мог
  // умереть, не сняв блокировку.
  lockedAt DateTime?
  lockedBy String?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // Разбор очереди: свежие queued вперёд.
  @@index([status, createdAt])
  // Экран проекта: «есть ли у меня незаконченное».
  @@index([conversationId, status])
  @@index([userId, createdAt])
}
