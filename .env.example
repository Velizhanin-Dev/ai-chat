ANTHROPIC_API_KEY=
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/creative_chat
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Яндекс.Метрика: номер счётчика. Без него метрика не подключается (window.ym = undefined).
# ВАЖНО: NEXT_PUBLIC_* инлайнится при `next build` → переменная нужна на BUILD-стадии
# (проброшена как build arg в docker-compose). После правки .env обязателен ПЕРЕСБОР:
#   docker compose up -d --build app
NEXT_PUBLIC_YM_ID=

# ── GLM (Z.ai / Zhipu) — второй движок модели, переключается в чате ─────────
# Без GLM_API_KEY выбор «GLM» в чате вернёт ошибку; Claude работает без этих ключей.
# GLM_BASE_URL: международный домен по умолчанию; для bigmodel.cn —
#   https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL: id модели у провайдера (по умолчанию glm-5.2).
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# ── OpenRouter — третий движок (шлюз к DeepSeek/Llama/Qwen/… ) ───────────────
# Провайдер и МОДЕЛЬ выбираются в админке (/admin/flags), модель — из каталога
# openrouter.ai (тянется по API). Плюс режим промпта: «умный роутинг» (наш BM25)
# или «полный промпт» (вся база знаний целиком — для моделей с кэшем контекста,
# напр. DeepSeek). Без OPENROUTER_API_KEY выбор OpenRouter вернёт ошибку в чате.
OPENROUTER_API_KEY=
# Дефолтная модель, если в админке не выбрана (напр. deepseek/deepseek-chat).
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_RETRIES=3   OPENROUTER_TIMEOUT_MS=60000

# ── Генератор превью ────────────────────────────────────────────────────────
# Картинки всегда генерятся через OpenRouter (ключ выше), независимо от движка
# чата. Модель выбирается в админке (/admin/flags → «Модель генерации превью»);
# ниже — дефолт, если не выбрана. Nano Banana Pro держит личность спикера с
# референсов и нормально рендерит кириллицу на превью.
# OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
# OPENROUTER_IMAGE_TIMEOUT_MS=180000
# Куда писать референсы и сгенерированные превью. В Docker переопределяется в
# docker-compose на /app/data/uploads (volume → ./data/uploads на хосте).
# UPLOAD_DIR=./data/uploads

# Auth: секрет для подписи JWT сессий (строка ≥16 символов, сгенерируйте свою).
JWT_SECRET=

# Письма (Unisender, метод sendEmail). Без UNISENDER_API_KEY/UNISENDER_LIST_ID
# письма не уходят — ссылка пишется в лог сервера (удобно в dev).
# UNISENDER_LIST_ID — код списка из кабинета (обязателен, от него предлагается
# отписка). sender_email в EMAIL_FROM должен быть подтверждён в Unisender.
UNISENDER_API_KEY=
UNISENDER_LIST_ID=
EMAIL_FROM="Велижанин AI <noreply@velizhanin.com>"

# ── OAuth-вход (VK ID / Яндекс) ────────────────────────────────────────────
# Redirect URI, который надо прописать в кабинете провайдера (домен = NEXT_PUBLIC_APP_URL):
#   Яндекс: {NEXT_PUBLIC_APP_URL}/api/auth/callback/yandex
#   VK ID:  {NEXT_PUBLIC_APP_URL}/api/auth/callback/vk
# Пусто → соответствующая кнопка вернёт на /login?error=oauth_unavailable.
#
# Яндекс (oauth.yandex.ru): нужен и ID, и секрет приложения.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID (id.vk.com): client_id = «ID приложения». Работает по PKCE — секрет
# опционален (оставь пустым, если VK его не требует для твоего типа приложения).
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ── Интеграция YouTube (Google OAuth + YouTube Data API v3 / Analytics API) ──
# Подключается в настройках («Интеграции»), данные канала — в разделе «Канал».
# Настройка в Google Cloud Console (console.cloud.google.com):
#   1) Создай проект и включи «YouTube Data API v3» и «YouTube Analytics API».
#   2) OAuth consent screen: тип External, scopes youtube.readonly + yt-analytics.readonly.
#   3) Credentials → OAuth client ID (тип Web application). Authorized redirect URI:
#        {NEXT_PUBLIC_APP_URL}/api/auth/callback  ← НЕ это;
#        {NEXT_PUBLIC_APP_URL}/api/integrations/youtube/callback
# Пусто → кнопка «Подключить» неактивна («интеграция не настроена»).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Поиск конкурентов в нише (раздел «Конкуренты», пока только админам) ──────
# Ищем чужие ролики публичным Data API — OAuth тут не нужен, хватает API-ключа
# (Credentials → API key, в проекте включён «YouTube Data API v3»).
#
# ⚠️ Почему ОТДЕЛЬНЫЕ ключи, а не токен канала: search.list стоит 100 units из
# 10 000 суточных (остальные вызовы — 1 unit), а квота списывается с проекта, чей
# ключ/OAuth-клиент используется. Ходить поиском в тот же проект, что и аналитика,
# нельзя — выжжем квоту и уроним раздел «Аналитика» у всех сразу.
#
# ⚠️ Ключи ЧЕРЕЗ ЗАПЯТУЮ и обязательно из РАЗНЫХ Google Cloud проектов: квота
# считается на проект, пять ключей одного проекта дадут те же 10 000 units.
# Работаем первым ключом, пока не упрётся в лимит, дальше сами переключаемся на
# следующий; счётчики обнуляются в полночь по тихоокеанскому времени.
# Пусто → раздел показывает «поиск не настроен», остальное работает как обычно.
YOUTUBE_API_KEYS=
# Опционально: суточный бюджет ОДНОГО ключа в units (дефолт 10000 — реальный лимит
# Google). Понижать имеет смысл, если тем же проектом пользуется что-то ещё.
# YOUTUBE_API_KEY_DAILY_UNITS=10000

# ── Оплата: ТБанк (рос. карты / СБП / Мир) ──────────────────────────────────
# Разовый платёж (доступ на 30 дней). Без TBANK_TERMINAL_KEY/TBANK_PASSWORD кнопка
# «Российская карта» отдаёт «Оплата временно недоступна». В кабинете ТБанк укажи тот
# же домен (NEXT_PUBLIC_APP_URL) для NotificationURL/SuccessURL/FailURL.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Опционально (есть дефолты):
# TBANK_API_URL=https://securepay.tinkoff.ru/v2
# TBANK_TAXATION=usn_income   # СНО для чека 54-ФЗ
# TBANK_VAT=none              # ставка НДС для чека
# TBANK_FFD_VERSION=          # версия ФФД (если требует касса)

# ── Оплата: CloudPayments (зарубежные карты Visa/Mastercard) ────────────────
# Второй способ оплаты (виджет на месте). Без ключей кнопка «Зарубежная карта»
# задизейблена. PUBLIC_ID — клиентский (виджет), инлайнится на BUILD-стадии (как
# NEXT_PUBLIC_YM_ID → нужен пересбор при правке). API_SECRET — серверный (HMAC
# вебхука + вызовы API). В кабинете CloudPayments укажи Pay-вебхук на
#   {NEXT_PUBLIC_APP_URL}/api/payments/cloudpayments/webhook
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# CLOUDPAYMENTS_API_URL=https://api.cloudpayments.ru

# ── Техподдержка: уведомления в Telegram ───────────────────────────────────
# Каждое сообщение из чата поддержки (/support) дублируется в телеграм-бот, чтобы
# вопрос не лежал непрочитанным. Отвечают НЕ из телеграма, а в /admin/support —
# бот односторонний (уведомление + ссылка на переписку). Без ключей уведомление
# просто не уходит (пишется предупреждение в лог), сам чат работает.
#   BOT_TOKEN — от @BotFather; CHAT_ID — куда слать (личка админа или группа;
#   для группы id отрицательный, узнать можно через @userinfobot / getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Опционально: базовый URL Bot API. Нужен, если api.telegram.org недоступен с
# сервера (РФ) — тогда ставим свой прокси. У нашего Caddy-прокси Telegram висит
# на пути /tg (handle_path срезает префикс), т.е. значение вида
#   TELEGRAM_API_BASE=https://<PROXY_DOMAIN>/tg
# ⚠️ прокси пускает только с IP прод-сервера — локально оставляй переменную
# пустой (пойдём напрямую), иначе получишь 403.
# TELEGRAM_API_BASE=https://api.telegram.org

# Бот поддержки в Telegram (@velizhaninai_support_bot). Секрет вебхука — любая
# строка; тем же значением регистрируется вебхук:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<домен>/api/telegram/webhook&secret_token=<СЕКРЕТ>"
# Без него вебхук отключён (сообщения из телеграма просто не принимаются).
TELEGRAM_WEBHOOK_SECRET=
