ANTHROPIC_API_KEY=
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/creative_chat
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── GLM (Z.ai / Zhipu) — второй движок модели, переключается в чате ─────────
# Без GLM_API_KEY выбор «GLM» в чате вернёт ошибку; Claude работает без этих ключей.
# GLM_BASE_URL: международный домен по умолчанию; для bigmodel.cn —
#   https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL: id модели у провайдера (по умолчанию glm-5.2).
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Auth: секрет для подписи JWT сессий (строка ≥16 символов, сгенерируйте свою).
JWT_SECRET=

# Письма (Unisender, метод sendEmail). Без UNISENDER_API_KEY/UNISENDER_LIST_ID
# письма не уходят — ссылка пишется в лог сервера (удобно в dev).
# UNISENDER_LIST_ID — код списка из кабинета (обязателен, от него предлагается
# отписка). sender_email в EMAIL_FROM должен быть подтверждён в Unisender.
UNISENDER_API_KEY=
UNISENDER_LIST_ID=
EMAIL_FROM="Велижанин AI <noreply@velizhanin.com>"

# ── OAuth-вход (VK ID / Яндекс) ────────────────────────────────────────────
# Redirect URI, который надо прописать в кабинете провайдера (домен = NEXT_PUBLIC_APP_URL):
#   Яндекс: {NEXT_PUBLIC_APP_URL}/api/auth/callback/yandex
#   VK ID:  {NEXT_PUBLIC_APP_URL}/api/auth/callback/vk
# Пусто → соответствующая кнопка вернёт на /login?error=oauth_unavailable.
#
# Яндекс (oauth.yandex.ru): нужен и ID, и секрет приложения.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID (id.vk.com): client_id = «ID приложения». Работает по PKCE — секрет
# опционален (оставь пустым, если VK его не требует для твоего типа приложения).
VK_CLIENT_ID=
VK_CLIENT_SECRET=
